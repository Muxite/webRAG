# Euglena / webRAG — environment template.
# Copy to `keys.env` (gitignored) and fill in. These are the variables needed to run a REAL
# query via `docker compose up`. See ../docs/CONFIGURATION.md for the full registry, including
# optional tuning knobs and the IDEA_TEST_* benchmark-only variables.

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider (REQUIRED) — choose ONE provider block.
# ─────────────────────────────────────────────────────────────────────────────
# Option A — OpenRouter (default; access to many models behind one key):
LLM_PROVIDER=openrouter
MODEL_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-...your-key...
MODEL_NAME=openai/gpt-4.1-nano          # any OpenRouter model slug

# Option B — OpenAI-compatible endpoint (uncomment, and comment out Option A):
# LLM_PROVIDER=openai_compatible
# MODEL_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...your-key...
# MODEL_NAME=gpt-5-mini

# ─────────────────────────────────────────────────────────────────────────────
# Web search (REQUIRED) — the agent's search tool.
# ─────────────────────────────────────────────────────────────────────────────
SEARCH_API_KEY=...your-search-provider-key...

# ─────────────────────────────────────────────────────────────────────────────
# Auth / Supabase (REQUIRED in production; relax for local dev — see below).
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_PUBLIC_KEY=...anon-public-key...
SUPABASE_JWT_SECRET=...hs256-jwt-secret...   # local/dev token verification
DAILY_TICK_LIMIT=6                            # per-user credits/day (1 task = 1 credit)

# Local dev shortcut: skip the Supabase quota check entirely (do NOT use in production).
# GATEWAY_TEST_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure URLs (defaults match docker-compose; override only if external).
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
CHROMA_URL=http://chroma:8000

# CORS for the browser frontend (comma-separated). Defaults cover localhost + the hosted UI.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
